[Unit]
Description=Rest Server for restic
After=network.target

[Service]
Type=simple
# Override with `systemctl edit restic-rest-server` (clear ExecStart= first)
ExecStart=/usr/bin/rest-server --path /var/lib/restic-rest-server --listen 127.0.0.1:8000 --private-repos
Restart=always
RestartSec=5
ReadWritePaths=/var/lib/restic-rest-server
UMask=077
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
